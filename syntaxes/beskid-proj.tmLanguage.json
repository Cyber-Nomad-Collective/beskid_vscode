{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Beskid BSOL",
	"scopeName": "source.beskid.proj",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#schemaless"
		},
		{
			"include": "#attributes-and-references"
		},
		{
			"include": "#block-kinds"
		},
		{
			"include": "#property-keys"
		},
		{
			"include": "#booleans-and-default"
		},
		{
			"include": "#type-constructors"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.bsol",
					"match": "#[^\\n]*"
				},
				{
					"name": "comment.line.double-slash.bsol",
					"match": "//[^\\n]*"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.bsol",
			"begin": "\"",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.bsol"
				}
			},
			"end": "\"",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.bsol"
				}
			}
		},
		"schemaless": {
			"name": "storage.modifier.bsol",
			"match": "@schemaless\\b"
		},
		"attributes-and-references": {
			"name": "variable.other.reference.bsol",
			"match": "@[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)?\\b"
		},
		"block-kinds": {
			"name": "keyword.control.bsol",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:\"[^\"]*\"\\s*)?(?:@schemaless\\s*)?\\{)"
		},
		"property-keys": {
			"name": "variable.other.property.bsol",
			"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)"
		},
		"booleans-and-default": {
			"name": "constant.language.boolean.bsol",
			"match": "\\b(?:true|false|default)\\b"
		},
		"type-constructors": {
			"name": "storage.type.bsol",
			"match": "\\b(?:map|list|ref)\\b(?=\\s*[\\[(])"
		},
		"numbers": {
			"name": "constant.numeric.bsol",
			"match": "\\b[0-9]+\\b"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.bsol",
					"match": "="
				},
				{
					"name": "keyword.operator.type.union.bsol",
					"match": "\\|"
				}
			]
		}
	}
}
