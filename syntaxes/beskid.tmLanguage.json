{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Beskid",
	"scopeName": "source.beskid",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#self-keywords" },
		{ "include": "#function-def" },
		{ "include": "#calls" },
		{ "include": "#attributes" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.beskid",
					"begin": "///",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.documentation.beskid" }
					},
					"end": "$"
				},
				{
					"name": "comment.line.double-slash.beskid",
					"begin": "//",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.beskid" }
					},
					"end": "$"
				},
				{
					"name": "comment.block.beskid",
					"begin": "/\\*",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.begin.beskid" }
					},
					"end": "\\*/",
					"endCaptures": {
						"0": { "name": "punctuation.definition.comment.end.beskid" }
					}
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.beskid",
			"begin": "\"",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.beskid" }
			},
			"end": "\"",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.beskid" }
			},
			"patterns": [
				{
					"name": "constant.character.escape.beskid",
					"match": "\\\\(?:[nrt\\\\\"0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f_]+\\})"
				},
				{
					"name": "constant.other.interpolation.beskid",
					"begin": "\\$\\{",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.interpolation.begin.beskid" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.definition.interpolation.end.beskid" }
					},
					"patterns": [
						{ "include": "$self" }
					]
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.beskid",
			"match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)\\b"
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.conditional.beskid",
					"match": "\\b(?:if|else|match|when)\\b"
				},
				{
					"name": "keyword.control.loop.beskid",
					"match": "\\b(?:while|for|in|break|continue)\\b"
				},
				{
					"name": "keyword.control.return.beskid",
					"match": "\\b(?:return)\\b"
				},
				{
					"name": "storage.type.keyword.beskid",
					"match": "\\b(?:type|enum|contract|attribute|impl|extend|host|scope|registry|test|macro|event)\\b"
				},
				{
					"name": "storage.modifier.beskid",
					"match": "\\b(?:mut|pub|ref|out|async|single|transient|global|parent)\\b"
				},
				{
					"name": "keyword.other.beskid",
					"match": "\\b(?:let|const|mod|use|spawn|await|launch|inject|with|init|dispose|startup|code|skip|meta|as|range|new|delete)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.primitive.beskid",
					"match": "\\b(?:bool|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|char|str|string|unit|never|pointer|word)\\b"
				},
				{
					"name": "entity.name.type.beskid",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.beskid",
					"match": "\\b(?:true|false)\\b"
				},
				{
					"name": "constant.language.wildcard.beskid",
					"match": "\\b_\\b"
				}
			]
		},
		"self-keywords": {
			"name": "variable.language.beskid",
			"match": "\\b(?:self|this|super)\\b"
		},
		"function-def": {
			"patterns": [
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "storage.type.beskid" },
						"2": { "name": "entity.name.function.beskid" }
					}
				}
			]
		},
		"calls": {
			"name": "support.function.beskid",
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
		},
		"attributes": {
			"name": "entity.name.tag.beskid",
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{ "include": "#keywords" },
				{ "include": "#strings" }
			]
		},
		"operators": {
			"name": "keyword.operator.beskid",
			"match": "===|!==|==|!=|<=|>=|&&|\\|\\||<<|>>|[+\\-*/%<>=!&|^]|=>|\\+=|-="
		}
	}
}
