{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Beskid",
	"scopeName": "source.beskid",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#characters" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#property-declarations" },
		{ "include": "#accessor-property" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#self-keywords" },
		{ "include": "#function-def" },
		{ "include": "#calls" },
		{ "include": "#attributes" },
		{ "include": "#operators" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.documentation.beskid",
					"begin": "///",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.documentation.beskid" }
					},
					"end": "$"
				},
				{
					"name": "comment.line.double-slash.beskid",
					"begin": "//",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.beskid" }
					},
					"end": "$"
				},
				{
					"name": "comment.block.beskid",
					"begin": "/\\*",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.comment.begin.beskid" }
					},
					"end": "\\*/",
					"endCaptures": {
						"0": { "name": "punctuation.definition.comment.end.beskid" }
					}
				}
			]
		},
		"characters": {
			"name": "string.quoted.single.beskid",
			"begin": "'(?=\\\\|[^'\\n])",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.beskid" }
			},
			"end": "'|(?=\\n)",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.beskid" }
			},
			"patterns": [
				{
					"name": "constant.character.escape.beskid",
					"match": "\\\\(?:[nrt\\\\'0]|u\\{[0-9A-Fa-f]{1,6}\\})"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.beskid",
			"begin": "\"",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.beskid" }
			},
			"end": "\"",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.beskid" }
			},
			"patterns": [
				{
					"name": "constant.character.escape.beskid",
					"match": "\\\\(?:[nrt\\\\\"0]|\\$\\{|u\\{[0-9A-Fa-f]{1,6}\\})"
				},
				{
					"name": "constant.other.interpolation.beskid",
					"begin": "\\$\\{",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.interpolation.begin.beskid" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.definition.interpolation.end.beskid" }
					},
					"patterns": [
						{ "include": "$self" }
					]
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.beskid",
			"match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?)?)(?:_(?:i8|i16|i32|i64|u8|u16|u32|u64|word|f32|f64))?\\b"
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.conditional.beskid",
					"match": "\\b(?:if|else|match|when)\\b"
				},
				{
					"name": "keyword.control.loop.beskid",
					"match": "\\b(?:while|for|in|break|continue)\\b"
				},
				{
					"name": "keyword.control.return.beskid",
					"match": "\\b(?:return)\\b"
				},
				{
					"name": "storage.type.keyword.beskid",
					"match": "\\b(?:type|enum|contract|attribute|impl|extend|host|scope|registry|test|macro|event)\\b"
				},
				{
					"name": "storage.modifier.beskid",
					"match": "\\b(?:mut|pub|ref|out|async|single|transient|global|parent)\\b"
				},
				{
					"name": "keyword.other.beskid",
					"match": "\\b(?:let|const|mod|use|spawn|await|launch|inject|with|init|dispose|startup|code|skip|meta|as|range|new|delete)\\b"
				}
			]
		},
		"property-declarations": {
			"patterns": [
				{
					"match": "\\b(prop)\\s+([A-Za-z_][A-Za-z0-9_:]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==(?!=|>))",
					"captures": {
						"1": { "name": "storage.modifier.beskid" },
						"2": { "name": "storage.type.beskid", "patterns": [{ "include": "#types" }] },
						"3": { "name": "variable.other.property.beskid" }
					}
				},
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_:]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==>)",
					"captures": {
						"1": { "name": "storage.type.beskid", "patterns": [{ "include": "#types" }] },
						"2": { "name": "variable.other.property.beskid" }
					}
				}
			]
		},
		"accessor-property": {
			"name": "meta.property.beskid",
			"begin": "\\b([A-Za-z_][A-Za-z0-9_:.]*(?:<[^{};=]+>)?(?:\\[\\])*)\\s+([A-Za-z_][A-Za-z0-9_]*(?=\\s*\\{\\s*(?:get\\b|set\\b|/\\*|//|$))|[A-Z][A-Za-z0-9_]*(?=\\s*(?://.*)?$))",
			"beginCaptures": {
				"1": { "name": "storage.type.beskid", "patterns": [{ "include": "#types" }] },
				"2": { "name": "variable.other.property.beskid" }
			},
			"end": "(?=[^\\s{])",
			"applyEndPatternLast": true,
			"patterns": [
				{ "include": "#comments" },
				{
					"begin": "\\{",
					"end": "\\}",
					"patterns": [
						{ "include": "#comments" },
						{
							"begin": "\\b(get)\\b",
							"beginCaptures": { "1": { "name": "keyword.declaration.accessor.beskid" } },
							"end": "(?=[^\\s{])",
							"applyEndPatternLast": true,
							"patterns": [
								{ "include": "#comments" },
								{ "include": "#accessor-getter-body" }
							]
						},
						{
							"begin": "\\b(set)\\b",
							"beginCaptures": { "1": { "name": "keyword.declaration.accessor.beskid" } },
							"end": "(?=[^\\s{])",
							"applyEndPatternLast": true,
							"patterns": [
								{ "include": "#comments" },
								{ "include": "#accessor-setter-body" }
							]
						}
					]
				}
			]
		},
		"accessor-qualified-member": {
			"match": "(?:\\.|::)\\s*(?:field|value)\\b"
		},
		"accessor-field": {
			"name": "variable.language.accessor.beskid",
			"match": "\\bfield\\b(?!\\s*\\()"
		},
		"accessor-getter-body": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{ "include": "#accessor-getter-body" },
				{ "include": "#accessor-qualified-member" },
				{ "include": "#accessor-field" },
				{ "include": "$self" }
			]
		},
		"accessor-setter-body": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{ "include": "#accessor-setter-body" },
				{ "include": "#accessor-qualified-member" },
				{ "include": "#accessor-field" },
				{
					"name": "variable.language.accessor.beskid",
					"match": "\\bvalue\\b(?!\\s*\\()"
				},
				{ "include": "$self" }
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.primitive.beskid",
					"match": "\\b(?:bool|i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|char|str|string|unit|never|pointer|word)\\b"
				},
				{
					"name": "entity.name.type.beskid",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.beskid",
					"match": "\\b(?:true|false)\\b"
				},
				{
					"name": "constant.language.wildcard.beskid",
					"match": "\\b_\\b"
				}
			]
		},
		"self-keywords": {
			"name": "variable.language.beskid",
			"match": "\\b(?:self|this|super)\\b"
		},
		"function-def": {
			"patterns": [
				{
					"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "storage.type.beskid" },
						"2": { "name": "entity.name.function.beskid" }
					}
				}
			]
		},
		"calls": {
			"name": "support.function.beskid",
			"match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
		},
		"attributes": {
			"name": "entity.name.tag.beskid",
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{ "include": "#keywords" },
				{ "include": "#strings" }
			]
		},
		"operators": {
			"name": "keyword.operator.beskid",
			"match": "===|!==|==|!=|<=|>=|&&|\\|\\||<<|>>|=>|[+\\-*/%]=|[+\\-*/%<>=!&|^?]"
		}
	}
}
