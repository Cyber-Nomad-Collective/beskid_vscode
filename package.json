{
  "name": "beskid-vscode",
  "displayName": "Beskid",
  "description": "Beskid language support for VS Code with bundled cross-platform LSP binaries and optional dev mode.",
  "version": "0.1.0",
  "publisher": "beskid",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyber-Nomad-Collective/beskid.git"
  },
  "homepage": "https://beskid-lang.org",
  "bugs": {
    "url": "https://github.com/Cyber-Nomad-Collective/beskid/issues"
  },
  "keywords": [
    "beskid",
    "language-server",
    "lsp",
    "programming-language",
    "compiler"
  ],
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "packageManager": "bun@1.2.20",
  "overrides": {
    "undici": "^8.2.0",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.4",
    "brace-expansion": "^5.0.5",
    "uuid": "^14.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "beskid.selectProject",
        "title": "Beskid: Select Project"
      },
      {
        "command": "beskid.focusProject",
        "title": "Beskid: Focus Project"
      },
      {
        "command": "beskid.clearFocus",
        "title": "Beskid: Clear Project Focus"
      },
      {
        "command": "beskid.refreshWorkspace",
        "title": "Beskid: Refresh Workspace"
      },
      {
        "command": "beskid.revealInWorkspaceTree",
        "title": "Beskid: Reveal in Workspaces"
      },
      {
        "command": "beskid.revealInProjectTree",
        "title": "Beskid: Reveal in Project"
      },
      {
        "command": "beskid.lsp.quickActions",
        "title": "Beskid: LSP Quick Actions"
      },
      {
        "command": "beskid.lsp.start",
        "title": "Beskid: Start Language Server"
      },
      {
        "command": "beskid.lsp.stop",
        "title": "Beskid: Stop Language Server"
      },
      {
        "command": "beskid.lsp.restart",
        "title": "Beskid: Restart Language Server"
      },
      {
        "command": "beskid.packages.open",
        "title": "Beskid: Open Package Manager"
      },
      {
        "command": "beskid.packages.search",
        "title": "Beskid: Search Packages"
      },
      {
        "command": "beskid.packages.showDetails",
        "title": "Beskid: Show Package Details"
      },
      {
        "command": "beskid.packages.addDependency",
        "title": "Beskid: Add Package Dependency"
      },
      {
        "command": "beskid.packages.fetch",
        "title": "Beskid: Fetch Packages"
      },
      {
        "command": "beskid.packages.lock",
        "title": "Beskid: Lock Project"
      },
      {
        "command": "beskid.packages.refresh",
        "title": "Beskid: Refresh Packages"
      },
      {
        "command": "beskid.packages.configureApiKey",
        "title": "Beskid: Configure Package Registry API Key"
      },
      {
        "command": "beskid.packages.openManifest",
        "title": "Beskid: Open Project Manifest"
      },
      {
        "command": "beskid.packages.openMaterializedFolder",
        "title": "Beskid: Open Materialized Package Folder"
      },
      {
        "command": "beskid.packages.copyDependencyLabel",
        "title": "Beskid: Copy Dependency Label"
      },
      {
        "command": "beskid.packages.openRegistryUri",
        "title": "Beskid: Open registry URL"
      },
      {
        "command": "beskid.cli.fetch",
        "title": "Beskid: CLI Fetch"
      },
      {
        "command": "beskid.cli.lock",
        "title": "Beskid: CLI Lock"
      },
      {
        "command": "beskid.cli.build",
        "title": "Beskid: CLI Build"
      },
      {
        "command": "beskid.cli.test",
        "title": "Beskid: CLI Test"
      },
      {
        "command": "beskid.cli.analyze",
        "title": "Beskid: CLI Analyze"
      },
      {
        "command": "beskid.lsp.openLogs",
        "title": "Beskid: Open LSP Logs"
      }
    ],
    "taskDefinitions": [
      {
        "type": "beskid-fetch",
        "required": [],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Project root or Project.proj path"
          }
        }
      },
      {
        "type": "beskid-lock",
        "required": [],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Project root or Project.proj path"
          }
        }
      },
      {
        "type": "beskid-build",
        "required": [],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Project root or Project.proj path"
          }
        }
      },
      {
        "type": "beskid-test",
        "required": [],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Project root or Project.proj path"
          }
        }
      },
      {
        "type": "beskid-analyze",
        "required": [],
        "properties": {
          "projectPath": {
            "type": "string",
            "description": "Project root or Project.proj path"
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "beskid.selectProject"
        },
        {
          "command": "beskid.lsp.quickActions"
        },
        {
          "command": "beskid.lsp.start"
        },
        {
          "command": "beskid.lsp.stop"
        },
        {
          "command": "beskid.lsp.restart"
        },
        {
          "command": "beskid.packages.open"
        },
        {
          "command": "beskid.packages.search"
        },
        {
          "command": "beskid.lsp.openLogs"
        }
      ],
      "view/title": [
        {
          "command": "beskid.packages.search",
          "when": "view == beskidPackagesView",
          "group": "navigation@1"
        },
        {
          "command": "beskid.packages.refresh",
          "when": "view == beskidPackagesView",
          "group": "navigation@2"
        },
        {
          "command": "beskid.packages.fetch",
          "when": "view == beskidPackagesView",
          "group": "navigation@3"
        },
        {
          "command": "beskid.packages.lock",
          "when": "view == beskidPackagesView",
          "group": "navigation@4"
        },
        {
          "command": "beskid.refreshWorkspace",
          "when": "view == beskidWorkspaceView",
          "group": "navigation"
        },
        {
          "command": "beskid.selectProject",
          "when": "view == beskidProjectView || view == beskidProjectOutlineView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "beskid.packages.showDetails",
          "when": "view == beskidPackagesView && viewItem == beskidRegistryPackage",
          "group": "inline"
        },
        {
          "command": "beskid.packages.addDependency",
          "when": "view == beskidPackagesView && viewItem == beskidRegistryPackage",
          "group": "1_packages"
        },
        {
          "command": "beskid.packages.openManifest",
          "when": "view == beskidPackagesView && viewItem == beskidLocalDependency",
          "group": "1_packages@1"
        },
        {
          "command": "beskid.packages.openMaterializedFolder",
          "when": "view == beskidPackagesView && viewItem == beskidLocalDependency",
          "group": "1_packages@2"
        },
        {
          "command": "beskid.packages.copyDependencyLabel",
          "when": "view == beskidPackagesView && viewItem == beskidLocalDependency",
          "group": "1_packages@3"
        },
        {
          "command": "beskid.focusProject",
          "when": "view == beskidWorkspaceView && viewItem == beskidWorkspaceMember",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "beskid.revealInProjectTree",
          "when": "resourceLangId == beskid || resourceLangId == beskid-proj",
          "group": "navigation@1"
        },
        {
          "command": "beskid.revealInWorkspaceTree",
          "when": "resourceLangId == beskid || resourceLangId == beskid-proj",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beskidViews",
          "title": "Beskid",
          "icon": "media/beskid-logo.svg"
        }
      ]
    },
    "views": {
      "beskidViews": [
        {
          "id": "beskidWorkspaceView",
          "name": "Workspaces"
        },
        {
          "id": "beskidProjectView",
          "name": "Project"
        },
        {
          "id": "beskidProjectOutlineView",
          "name": "Outline"
        },
        {
          "id": "beskidPackagesView",
          "name": "Packages"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "beskidPackagesView",
        "contents": "Search the Beskid package registry.\n[Search packages](command:beskid.packages.search)"
      }
    ],
    "languages": [
      {
        "id": "beskid",
        "aliases": [
          "Beskid",
          "beskid"
        ],
        "extensions": [
          ".bd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "beskid-proj",
        "aliases": [
          "Beskid Project",
          "beskid-proj"
        ],
        "extensions": [
          ".proj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "beskid",
        "scopeName": "source.beskid",
        "path": "./syntaxes/beskid.tmLanguage.json"
      },
      {
        "language": "beskid-proj",
        "scopeName": "source.beskid.proj",
        "path": "./syntaxes/beskid-proj.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Beskid LSP",
      "properties": {
        "beskid.lsp.server.command": {
          "type": "string",
          "default": "cargo",
          "description": "LSP launch command used in dev mode (requires `beskid.lsp.server.devMode=true`)."
        },
        "beskid.lsp.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "run",
            "-p",
            "beskid_lsp"
          ],
          "description": "LSP launch args used in dev mode (requires `beskid.lsp.server.devMode=true`)."
        },
        "beskid.lsp.server.preferBundled": {
          "type": "boolean",
          "default": true,
          "description": "Use bundled platform server binary under extension `server/<platform>-<arch>/`."
        },
        "beskid.lsp.server.devMode": {
          "type": "boolean",
          "default": false,
          "description": "Launch LSP from source (requires repo cloned locally). When false, extension expects bundled binary or explicit `server.path`."
        },
        "beskid.lsp.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Beskid LSP binary. Overrides bundled and fallback command settings."
        },
        "beskid.lsp.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory for the language server process. Empty means current workspace root."
        },
        "beskid.lsp.server.debugArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "run",
            "-p",
            "beskid_lsp"
          ],
          "description": "Arguments used when VS Code launches the extension in debug mode (dev mode)."
        },
        "beskid.lsp.log.level": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "log",
            "debug"
          ],
          "default": "info",
          "description": "Language server log level routed to VS Code output."
        },
        "beskid.lsp.log.serverOutput": {
          "type": "boolean",
          "default": true,
          "description": "Mirror server output to the Beskid LSP output channel."
        },
        "beskid.pckg.baseUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Base URL of the pckg server used by the package manager pane."
        },
        "beskid.pckg.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for private registry access. Prefer storing via command palette when available; falls back to SecretStorage when empty."
        },
        "beskid.cli.path": {
          "type": "string",
          "default": "beskid",
          "description": "Path to the Beskid CLI binary for fetch, lock, build, and other tasks."
        },
        "beskid.project.autoSelectFromEditor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically focus the Beskid project manifest for the active editor file."
        }
      }
    },
    "configurationDefaults": {
      "[beskid]": {
        "editor.defaultFormatter": "beskid.beskid-vscode"
      },
      "[beskid-proj]": {
        "editor.defaultFormatter": "beskid.beskid-vscode"
      }
    }
  },
  "scripts": {
    "sync:keywords": "bun scripts/sync-keywords.mjs",
    "build": "bunx tsc -p .",
    "watch": "bunx tsc -w -p .",
    "lint": "bunx tsc -p . --noEmit",
    "test": "bun test",
    "test:e2e": "bun test test/e2e",
    "test:smoke:formatter": "node scripts/smoke-formatter.mjs",
    "package": "bunx @vscode/vsce package",
    "vscode:prepublish": "bun run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "1.88.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
