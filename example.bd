type User {
    i32 id,
    string name,
}

type Point {
    i32 x,
    i32 y,
}

enum Option<T> {
    Some(T value),
    None,
}

User make_user(i32 id, string name) {
    return User { id: id, name: name };
}

unit Main(){
    User user = make_user(1, "John");
    System.Output.WriteLine("User:");
    System.Output.WriteLine(user.name);
}
